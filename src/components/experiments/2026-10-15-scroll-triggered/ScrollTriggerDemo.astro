---
const items = ['進場', '播放', '離場', '倒轉', '再次進場', '完成'];
---

<div class="st-demo" data-st-demo>
  <p class="st-note" data-st-note></p>
  <div class="st-box" tabindex="0" aria-label="捲動區域">
    <p class="st-hint">往下捲動 ↓</p>
    {items.map((t, i) => (
      <div class="st-card">
        <span class="st-n">{String(i + 1).padStart(2, '0')}</span>
        <span>{t}</span>
      </div>
    ))}
    <div class="st-pad"></div>
  </div>
</div>

<style>
  .st-demo { margin: 1.5rem 0; }
  .st-note { font-size: 0.85rem; opacity: 0.75; margin: 0 0 0.5rem; }
  .st-box {
    height: 340px; overflow-y: auto; padding: 1rem;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 12px; display: grid; gap: 1.5rem; align-content: start;
  }
  .st-hint { margin: 0; text-align: center; opacity: 0.6; }
  .st-pad { height: 120px; }
  .st-card {
    display: flex; gap: 1rem; align-items: center;
    padding: 1.25rem 1rem; border-radius: 10px;
    background: linear-gradient(120deg, #6d5efc, #e85d9a); color: #fff;
    font-weight: 600; font-size: 1.1rem;
    --dur: 0.5s;
  }
  .st-n { font-variant-numeric: tabular-nums; opacity: 0.8; }

  @keyframes st-in {
    from { opacity: 0; transform: translateX(-40px) scale(0.92); }
    to { opacity: 1; transform: none; }
  }

  /* 原生：scroll-triggered animations（Chrome 145+） */
  @supports (timeline-trigger: --t view()) {
    @media (prefers-reduced-motion: no-preference) {
      .st-card {
        timeline-trigger: --t view() contain 0% contain 100% / entry 100% exit 0%;
        trigger-scope: --t;
        animation: st-in var(--dur) ease-out both;
        animation-trigger: --t play-forwards play-backwards;
      }
    }
  }

  /* 不支援時，由 script 加上 .st-js 與 .st-in */
  .st-demo.st-js .st-card { opacity: 0; transform: translateX(-40px) scale(0.92); transition: opacity var(--dur), transform var(--dur); }
  .st-demo.st-js .st-card.st-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .st-demo.st-js .st-card { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-st-demo]').forEach((root) => {
    const note = root.querySelector('[data-st-note]')!;
    const native = CSS.supports('timeline-trigger', '--t view()');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (native) {
      note.textContent = reduce
        ? '偵測到「減少動態」，動畫已關閉。'
        : '目前使用原生 timeline-trigger，沒有任何 JS 在監聽捲動。';
      return;
    }
    note.textContent = '你的瀏覽器尚未支援 timeline-trigger，改用 IntersectionObserver 模擬。';
    root.classList.add('st-js');
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => e.target.classList.toggle('st-in', e.isIntersecting)),
      { root: root.querySelector('.st-box'), threshold: 0.3 },
    );
    root.querySelectorAll('.st-card').forEach((c) => io.observe(c));
  });
</script>
