---
// Concept A — 藍曬筆記 (cyanotype lab notebook)
import LabShell from '../../lab/LabShell.astro';
import { posts, projects, links } from '../../lab/sample';

const fmt = (d: Date) =>
	`${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<LabShell title="A 藍曬筆記" fonts="https://fonts.googleapis.com/css2?family=LXGW+WenKai+TC:wght@300;400;700&display=swap">
	<div class="sheet">
		<header class="masthead">
			<p class="owner">Lun Hackin</p>
			<h1>寫程式的<br />實驗筆記</h1>
			<p class="lede">我在這裡記錄做過的東西：智能合約、前端介面，還有途中想通的事。</p>
			<ul class="links">
				{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
			</ul>
		</header>

		<section class="log" aria-labelledby="log-title">
			<h2 id="log-title">最近的筆記</h2>
			<ol>
				{
					posts.map((p) => (
						<li>
							<time datetime={p.date.toISOString()}>{fmt(p.date)}</time>
							<div>
								<a href={p.href}>{p.title}</a>
								<p>{p.description}</p>
							</div>
						</li>
					))
				}
			</ol>
			<a class="more" href="/blog">翻看全部筆記</a>
		</section>

		<section class="plates" aria-labelledby="plates-title">
			<h2 id="plates-title">做過的東西</h2>
			<div class="plate-grid">
				{
					projects.map((p, i) => (
						<figure>
							<a class="plate" href={p.href}>
								<span class="plate-name">{p.name}</span>
								<span class="plate-tags">{p.tags.join(' / ')}</span>
							</a>
							<figcaption>
								<span class="fig-no">圖 {i + 1}</span>
								{p.summary}
							</figcaption>
						</figure>
					))
				}
			</div>
		</section>
	</div>
</LabShell>

<style>
	:global(body) {
		--ground: #10294a;
		--ink: #e6eef7;
		--muted: #9db2cc;
		--grid: rgb(220 232 245 / 0.07);
		--margin-line: rgb(243 224 122 / 0.45);
		--mark: #f3e07a;

		background-color: var(--ground);
		background-image:
			linear-gradient(var(--grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid) 1px, transparent 1px);
		background-size: 28px 28px;
		color: var(--ink);
		font-family: 'LXGW WenKai TC', 'Noto Sans TC', sans-serif;
		font-size: 1.125rem;
		line-height: 1.8;
	}

	.sheet {
		max-width: 68rem;
		margin: 0 auto;
		padding: clamp(3rem, 8vw, 6rem) 1rem 7rem;
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
	}
	.sheet > * {
		grid-column: 2;
		border-left: 1px solid var(--margin-line);
		padding-left: clamp(1rem, 4vw, 3rem);
	}

	a {
		color: inherit;
		text-decoration: none;
		background: linear-gradient(transparent 60%, transparent 60%);
		transition: background 160ms ease;
	}
	a:hover,
	a:focus-visible {
		background: linear-gradient(transparent 58%, rgb(243 224 122 / 0.35) 58%);
	}
	a:focus-visible {
		outline: 2px dashed var(--mark);
		outline-offset: 3px;
	}

	.masthead {
		padding-bottom: 4rem;
	}
	.owner {
		margin: 0 0 1rem;
		color: var(--muted);
	}
	h1 {
		margin: 0;
		font-weight: 700;
		font-size: clamp(3rem, 10vw, 7.5rem);
		line-height: 1.05;
		letter-spacing: 0.02em;
	}
	.lede {
		max-width: 30em;
		margin: 2rem 0 1.5rem;
		font-size: 1.25rem;
		color: var(--ink);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--muted);
	}

	h2 {
		margin: 0 0 1.5rem;
		font-size: 1.5rem;
		font-weight: 700;
	}

	.log {
		padding-bottom: 4rem;
	}
	.log ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.log li {
		position: relative;
		padding: 0.75rem 0;
	}
	.log time {
		position: absolute;
		right: calc(100% + clamp(1rem, 4vw, 3rem) + 1.25rem);
		top: 0.9rem;
		white-space: nowrap;
		color: var(--muted);
		font-size: 0.95rem;
		font-variant-numeric: tabular-nums;
	}
	.log li a {
		font-size: 1.375rem;
		font-weight: 700;
	}
	.log li p {
		margin: 0.25rem 0 0;
		max-width: 34em;
		color: var(--muted);
	}
	.more {
		display: inline-block;
		margin-top: 1rem;
		color: var(--mark);
	}

	.plate-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 2rem;
	}
	figure {
		margin: 0;
	}
	.plate {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		aspect-ratio: 4 / 3;
		padding: 1.25rem;
		border: 1px dashed rgb(230 238 247 / 0.45);
		background: rgb(16 41 74 / 0.6);
	}
	.plate:hover,
	.plate:focus-visible {
		background: rgb(243 224 122 / 0.08);
	}
	/* registration marks, as if the sheet were taped to the page */
	.plate::before,
	.plate::after {
		content: '';
		position: absolute;
		width: 14px;
		height: 14px;
		border-color: var(--ink);
		border-style: solid;
	}
	.plate::before {
		top: -7px;
		left: -7px;
		border-width: 1px 0 0 1px;
	}
	.plate::after {
		bottom: -7px;
		right: -7px;
		border-width: 0 1px 1px 0;
	}
	.plate-name {
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.2;
	}
	.plate-tags {
		color: var(--muted);
		font-size: 0.95rem;
	}
	figcaption {
		margin-top: 0.75rem;
		color: var(--muted);
		font-size: 1rem;
	}
	.fig-no {
		margin-right: 0.5em;
		color: var(--ink);
	}

	@media (max-width: 720px) {
		.sheet {
			grid-template-columns: minmax(0, 1fr);
		}
		.sheet > * {
			grid-column: 1;
		}
		.log time {
			position: static;
			display: block;
		}
	}
</style>
