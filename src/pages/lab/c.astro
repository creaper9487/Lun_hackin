---
// Concept C — 直排檔案 (vertical-set archive)
import LabShell from '../../lab/LabShell.astro';
import { posts, projects, links } from '../../lab/sample';

const DIGITS = '〇一二三四五六七八九';
const year = (n: number) => [...String(n)].map((d) => DIGITS[Number(d)]).join('');
const small = (n: number) => {
	if (n < 10) return DIGITS[n];
	const tens = Math.floor(n / 10);
	const ones = n % 10;
	return `${tens === 1 ? '' : DIGITS[tens]}十${ones ? DIGITS[ones] : ''}`;
};
const fmt = (d: Date) => `${year(d.getFullYear())}年${small(d.getMonth() + 1)}月${small(d.getDate())}日`;
---

<LabShell title="C 直排檔案" fonts="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;900&display=swap">
	<div class="page">
		<header class="title-block">
			<h1>寫程式，也寫下來</h1>
			<div class="signature">
				<span class="name">Lun Hackin</span>
				<span class="seal" aria-hidden="true">筆記</span>
			</div>
		</header>

		<main class="body">
			<p class="intro">
				這裡收著我寫過的文章和做過的專案。大多和智能合約、前端介面有關，偶爾也記一些與程式無關的想法。
			</p>

			<section aria-labelledby="posts-title">
				<h2 id="posts-title">文章</h2>
				<ol class="entries">
					{
						posts.map((p) => (
							<li>
								<a href={p.href}>{p.title}</a>
								<time datetime={p.date.toISOString()}>{fmt(p.date)}</time>
								<p>{p.description}</p>
							</li>
						))
					}
				</ol>
				<a class="more" href="/blog">所有文章</a>
			</section>

			<section aria-labelledby="projects-title">
				<h2 id="projects-title">作品</h2>
				<dl class="projects">
					{
						projects.map((p) => (
							<div>
								<dt>
									<a href={p.href}>{p.name}</a>
								</dt>
								<dd>{p.summary}</dd>
								<dd class="tags">{p.tags.join('，')}</dd>
							</div>
						))
					}
				</dl>
			</section>

			<footer class="foot">
				{links.map((l) => <a href={l.href}>{l.label}</a>)}
			</footer>
		</main>
	</div>
</LabShell>

<style>
	:global(body) {
		--ground: #1a1f1a;
		--surface: #232a23;
		--bone: #e6e0cf;
		--muted: #a39e8c;
		--brass: #c2a363;
		--seal: #b8432f;

		background: var(--ground);
		color: var(--bone);
		font-family: 'Noto Serif TC', serif;
		font-size: 1.0625rem;
		line-height: 1.95;
	}

	.page {
		max-width: 72rem;
		margin: 0 auto;
		padding: clamp(3rem, 8vw, 6rem) 1rem 7rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas: 'body title';
		gap: clamp(2rem, 8vw, 7rem);
	}

	a {
		color: inherit;
		text-decoration-line: underline;
		text-decoration-color: rgb(194 163 99 / 0.4);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.35em;
	}
	a:hover {
		color: var(--brass);
		text-decoration-color: currentColor;
	}
	a:focus-visible {
		outline: 1px solid var(--brass);
		outline-offset: 4px;
	}

	.title-block {
		grid-area: title;
		position: sticky;
		top: clamp(3rem, 8vw, 6rem);
		align-self: start;
		display: flex;
		flex-direction: row-reverse;
		gap: 1.5rem;
		writing-mode: horizontal-tb;
	}
	h1 {
		margin: 0;
		writing-mode: vertical-rl;
		font-size: clamp(2.5rem, 5.5vw, 4.25rem);
		font-weight: 900;
		line-height: 1.15;
		letter-spacing: 0.12em;
	}
	.signature {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		gap: 1rem;
	}
	.name {
		writing-mode: vertical-rl;
		color: var(--muted);
		letter-spacing: 0.1em;
	}
	.seal {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		writing-mode: vertical-rl;
		background: var(--seal);
		color: var(--bone);
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.1;
		border-radius: 3px;
	}

	.body {
		grid-area: body;
		max-width: 38rem;
		justify-self: end;
	}
	.intro {
		margin: 0 0 4rem;
		font-size: 1.25rem;
		line-height: 2;
	}

	h2 {
		margin: 0 0 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid rgb(194 163 99 / 0.35);
		color: var(--brass);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.2em;
	}
	section {
		margin-bottom: 4rem;
	}

	.entries {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.entries li {
		margin-bottom: 2rem;
	}
	.entries a {
		font-size: 1.375rem;
		font-weight: 600;
		line-height: 1.5;
	}
	.entries time {
		display: block;
		margin-top: 0.25rem;
		color: var(--muted);
		font-size: 0.875rem;
		letter-spacing: 0.05em;
	}
	.entries p {
		margin: 0.5rem 0 0;
	}
	.more {
		color: var(--brass);
	}

	.projects {
		margin: 0;
	}
	.projects > div {
		padding: 1.25rem 1.5rem;
		margin-bottom: 1rem;
		background: var(--surface);
	}
	dt {
		font-size: 1.25rem;
		font-weight: 600;
	}
	dd {
		margin: 0.25rem 0 0;
	}
	dd.tags {
		color: var(--muted);
		font-size: 0.875rem;
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.75rem;
		padding-top: 1rem;
		border-top: 1px solid rgb(194 163 99 / 0.35);
		color: var(--muted);
	}

	@media (max-width: 720px) {
		.page {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: 'title' 'body';
		}
		.title-block {
			position: static;
			justify-self: end;
			height: auto;
		}
		.body {
			justify-self: stretch;
		}
	}
</style>
