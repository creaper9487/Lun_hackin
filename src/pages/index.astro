---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const projectHref = (id: string) => `/projects/${id}/`;
const projectById = new Map(projects.map((project) => [project.id, project]));

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
// the back of each Works card is the experience entry at the same position
const flipTone = (tone: string) => (tone === 'blue' ? 'pink' : 'blue');

const interests = [
	{ title: 'Smart contracts', description: "Move and Sui's object model, and making permissions and the flow of assets obvious at a glance.", tag: 'MOVE / SUI', keywords: ['Object model', 'Permissions', 'Custody'], related: ['sup-wallet'] },
	{ title: 'Interaction experiments', description: 'Turning small ideas into interfaces you can touch, and watching how tiny details change how it feels.', tag: 'FRONTEND', keywords: ['Micro-interactions', 'Scroll stories', 'Motion'], related: ['interaction-lab'] },
	{ title: 'Web craft', description: 'Finding a simple, maintainable way to combine Astro, React and Vue.', tag: 'WEB / UI', keywords: ['Islands', 'Content collections', 'i18n'], related: ['lun-hackin'] },
];
const pad = (n: number) => String(n).padStart(2, '0');

const railMarks = [
	{ href: '#top', label: 'Home' },
	{ href: '#work', label: 'Works' },
	{ href: '#interests', label: 'Interests' },
];

const formatDate = (date: Date) => date.toLocaleDateString('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit' }).replaceAll('-', '.');
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} showSiteChrome={false}>
	<div class="landing-page">
		<header class="masthead" id="top">
			<a class="wordmark" href="#top" aria-label="Lun-hackin home">@Lun-hackin</a>
			<nav class="social-links" aria-label="Social links">
				<a href="https://github.com/" aria-label="GitHub" title="GitHub"><span aria-hidden="true">GH</span></a>
				<a href="https://x.com/" aria-label="X" title="X"><span aria-hidden="true">𝕏</span></a>
				<a href="mailto:hello@lun-hackin.dev" aria-label="Email" title="Email"><span aria-hidden="true">✉</span></a>
				<a href="/rss.xml" aria-label="RSS" title="RSS"><span aria-hidden="true">◔</span></a>
			</nav>
		</header>

		<main>
			<section class="overview" aria-label="Recent content">
				<div class="overview-column featured-projects">
					<div class="section-label"><h2>Works</h2><a href="#work">Scroll down <span aria-hidden="true">↓</span></a></div>
					<ul class="project-list">
						{projects.map((project) => (
							<li>
								<a href={projectHref(project.id)}>
									<span class="list-arrow" aria-hidden="true">⟶</span>
									<span><strong>{project.data.title}</strong><small>{project.data.description}</small></span>
								</a>
							</li>
						))}
					</ul>
					<a class="text-link" href="/projects/">All projects <span aria-hidden="true">↗</span></a>
				</div>

				<div class="overview-column recent-writing">
					<div class="section-label"><h2>Writing</h2><a href="/blog">All posts <span aria-hidden="true">↗</span></a></div>
					<div class="article-list">
						{posts.length ? posts.slice(0, 4).map((post) => (
							<a class="article-row" href={`/blog/${post.id}/`}>
								<div class="article-copy">
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									{post.data.tags.length > 0 && <div class="tag-list">{post.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}</div>}
								</div>
								<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
							</a>
						)) : <p class="empty-note">New posts are on the way.</p>}
					</div>
					<p class="scroll-note"><span class="wave-mark" aria-hidden="true">∿∿∿∿</span> Keep scrolling</p>
				</div>
			</section>

			<section class="journey-section work-section" id="work" aria-labelledby="work-title" data-journey="strip" data-view="projects">
				<div class="journey-sticky">
					<div class="journey-heading">
						<p class="eyebrow" data-eyebrow>SELECTED PROJECTS</p>
						<h2 id="work-title" class="works-title">
							<button class="works-switch" type="button" role="switch" aria-checked="false" aria-label="Works: switch between projects and experience">
								<span class="works-thumb" aria-hidden="true"></span>
								<span class="works-label" data-for="projects">Project</span>
								<span class="works-label" data-for="experience">Exp.</span>
							</button>
						</h2>
						<span class="journey-count" aria-hidden="true" data-step>01 / {pad(projects.length)}</span>
					</div>
					<div class="project-rail" aria-label="Works">
						{projects.map((project, index) => {
							const entry = experience[index];
							const Back = entry?.data.link ? 'a' : 'div';
							return (
								<div class="flip-card" style={`--i: ${index}`}>
									<div class="flip-inner">
										<a class:list={['showcase-card', 'tone-panel', 'face-front', project.data.tone]} href={projectHref(project.id)}>
											<canvas class="dot-field" aria-hidden="true" data-tone={project.data.tone}></canvas>
											<div class="card-meta"><span>{project.data.year}</span><span>{pad(index + 1)} / {pad(projects.length)}</span></div>
											<div class="card-main"><h3>{project.data.title}</h3><p>{project.data.description}</p></div>
											<div class="card-footer"><span>{project.data.stack.join(' · ')}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
										</a>
										<Back class:list={['showcase-card', 'tone-panel', 'face-back', flipTone(project.data.tone)]} href={entry?.data.link} inert>
											<canvas class="dot-field" aria-hidden="true" data-tone={flipTone(project.data.tone)}></canvas>
											<div class="card-meta"><span>{entry ? entry.data.period : '—'}</span><span>{pad(index + 1)} / {pad(projects.length)}</span></div>
											<div class="card-main">
												<h3>{entry ? entry.data.organization : 'More soon'}</h3>
												<p>{entry ? `${entry.data.role}. ${entry.data.summary}` : 'Nothing here yet.'}</p>
											</div>
											<div class="card-footer"><span>{entry ? entry.data.tags.join(' · ') : ''}</span>{entry?.data.link && <span class="card-arrow" aria-hidden="true">↗</span>}</div>
										</Back>
									</div>
								</div>
							);
						})}
					</div>
				</div>
			</section>

			<section class="journey-section interests-section" id="interests" aria-labelledby="interests-title" data-journey="deck">
				<div class="journey-sticky interest-sticky">
					<div class="journey-heading"><p class="eyebrow">THINGS I LIKE</p><h2 id="interests-title">Interests</h2><span class="journey-count" aria-hidden="true" data-step>01 / {pad(interests.length)}</span></div>
					<div class="interest-rail">
						{interests.map((interest, index) => (
							<article class:list={['interest-card', index % 2 ? 'interest-alt' : '', index === 0 && 'is-active']}>
								<div class="interest-top"><span>{interest.tag}</span><span>{pad(index + 1)} / {pad(interests.length)}</span></div>
								<span class="interest-index" aria-hidden="true" data-n={pad(index + 1)}>{pad(index + 1)}</span>
								<div class="interest-copy">
									<h3>{interest.title}</h3>
									<p>{interest.description}</p>
									<ul class="keyword-list" aria-label="Keywords">{interest.keywords.map((keyword) => <li>{keyword}</li>)}</ul>
								</div>
								<div class="interest-related">
									<span class="related-label">Related</span>
									{interest.related.map((id) => projectById.get(id)).filter((project) => project !== undefined).map((project) => (
										<a href={projectHref(project.id)}><span>{project.data.title}</span><span aria-hidden="true">⟶</span></a>
									))}
								</div>
							</article>
						))}
					</div>
				</div>
			</section>
		</main>

		<nav class="page-rail" aria-label="Page progress">
			<span class="page-rail-fill" aria-hidden="true"></span>
			{railMarks.map((mark, index) => (
				<a href={mark.href} style={`--at: ${index / railMarks.length}`} data-label={mark.label} aria-label={mark.label}></a>
			))}
		</nav>

		<footer class="landing-footer"><a href="#top">Back to top ↑</a><span>© {new Date().getFullYear()} Lun-hackin</span><span>Always making, out of curiosity.</span></footer>
	</div>
</BaseLayout>

<script>
	import { initDotFields } from '../lib/dotField';

	initDotFields(document.querySelectorAll<HTMLCanvasElement>('.showcase-card .dot-field'));

	// Works switch: flips every card between the project (front) and the experience entry (back).
	const works = document.querySelector<HTMLElement>('#work');
	const switchButton = works?.querySelector<HTMLButtonElement>('.works-switch');
	const eyebrow = works?.querySelector('[data-eyebrow]');
	const labels = { projects: 'SELECTED PROJECTS', experience: 'EXPERIENCE & ORGANIZATIONS' };

	function setView(view: keyof typeof labels) {
		if (!works || !switchButton) return;
		works.dataset.view = view;
		switchButton.setAttribute('aria-checked', String(view === 'experience'));
		if (eyebrow) eyebrow.textContent = labels[view];
		// the hidden face must not be reachable by keyboard or assistive tech
		works.querySelectorAll<HTMLElement>('.face-front').forEach((face) => (face.inert = view === 'experience'));
		works.querySelectorAll<HTMLElement>('.face-back').forEach((face) => (face.inert = view === 'projects'));
	}
	switchButton?.addEventListener('click', () => setView(works?.dataset.view === 'experience' ? 'projects' : 'experience'));

	// Pins the two journey sections and drives them from page scroll: the project strip slides
	// sideways, the interest cards swap. Without this script the cards simply stack (see global.css).
	const root = document.documentElement;
	const strip = document.querySelector<HTMLElement>('[data-journey="strip"]');
	const deck = document.querySelector<HTMLElement>('[data-journey="deck"]');
	const track = strip?.querySelector<HTMLElement>('.project-rail');
	const cards = [...(deck?.querySelectorAll<HTMLElement>('.interest-card') ?? [])];
	const fill = document.querySelector<HTMLElement>('.page-rail-fill');
	const marks = [...document.querySelectorAll<HTMLAnchorElement>('.page-rail a')];

	if (strip && deck && track && fill) {
		root.dataset.pinned = '';

		const clamp = (v: number) => Math.min(1, Math.max(0, v));
		const top = (el: HTMLElement) => el.getBoundingClientRect().top + scrollY;
		// 0..1 across the extra scroll a pinned section adds beyond one screen
		const local = (section: HTMLElement) => clamp((scrollY - top(section)) / (section.offsetHeight - innerHeight));
		const pad = (n: number) => String(n).padStart(2, '0');
		const setStep = (section: HTMLElement, index: number, total: number) => {
			const step = section.querySelector('[data-step]');
			if (step) step.textContent = `${pad(index + 1)} / ${pad(total)}`;
		};

		// The rail is split into equal segments (top → work → interests → end), each filled by real progress,
		// so the marks sit at fixed points no matter how tall each part of the page is.
		function railProgress(y: number, starts: number[]) {
			const segments = starts.length - 1;
			for (let i = 0; i < segments; i++) {
				if (y < starts[i + 1] || i === segments - 1) {
					const length = starts[i + 1] - starts[i];
					return (i + (length <= 0 ? 1 : clamp((y - starts[i]) / length))) / segments;
				}
			}
			return 1;
		}

		let queued = false;
		function frame() {
			queued = false;
			const y = scrollY;
			const starts = [0, top(strip!), top(deck!), root.scrollHeight - innerHeight];

			fill!.style.transform = `scaleY(${railProgress(y, starts)})`;
			const current = starts.slice(0, marks.length).findLastIndex((start) => y >= start - 2);
			marks.forEach((mark, i) => {
				mark.classList.toggle('is-passed', i <= current);
				if (i === current) mark.setAttribute('aria-current', 'location');
				else mark.removeAttribute('aria-current');
			});

			const stripProgress = local(strip!);
			const travel = Math.max(0, track!.offsetWidth - strip!.clientWidth);
			track!.style.transform = `translateX(${-stripProgress * travel}px)`;
			const slides = track!.children.length;
			setStep(strip!, Math.round(stripProgress * (slides - 1)), slides);

			const active = Math.min(cards.length - 1, Math.floor(local(deck!) * cards.length));
			cards.forEach((card, i) => card.classList.toggle('is-active', i === active));
			setStep(deck!, active, cards.length);
		}
		const request = () => {
			if (!queued) {
				queued = true;
				requestAnimationFrame(frame);
			}
		};

		// Keyboard focus landing in a hidden interest card scrolls the page until that card is the active one.
		cards.forEach((card, i) => {
			card.addEventListener('focusin', () => {
				if (card.classList.contains('is-active')) return;
				const span = deck!.offsetHeight - innerHeight;
				scrollTo({ top: top(deck!) + ((i + 0.5) / cards.length) * span, behavior: 'instant' });
			});
		});

		addEventListener('scroll', request, { passive: true });
		addEventListener('resize', request);
		document.fonts?.ready.then(request);
		frame();
	}
</script>
