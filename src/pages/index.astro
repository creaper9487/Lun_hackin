---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const projects = [
	{
		title: 'sup_wallet',
		description: 'Sui Move 錢包合約，處理資產託管與授權。',
		year: '2026',
		stack: ['Move', 'Sui'],
		tone: 'pink',
	},
	{
		title: 'Lun-hackin',
		description: '這個網站。Astro 搭配 React 與 Vue 元件。',
		year: '2026',
		stack: ['Astro', 'React', 'Vue'],
		tone: 'blue',
	},
	{
		title: '互動實驗室',
		description: '小型前端互動 demo，記錄想法與試驗。',
		year: '2026',
		stack: ['React', 'CSS'],
		tone: 'pink',
	},
];

const interests = [
	{ number: '01 / 03', title: '智能合約', description: 'Move 和 Sui 的物件模型。怎麼讓權限和資產的流向一眼就看得懂。', tag: 'MOVE / SUI' },
	{ number: '02 / 03', title: '互動實驗', description: '把小小的點子做成可以操作的介面，觀察細節如何改變使用感受。', tag: 'FRONTEND' },
	{ number: '03 / 03', title: '網頁技術', description: '在 Astro、React 和 Vue 之間找到簡潔、好維護的組合方式。', tag: 'WEB / UI' },
];

const formatDate = (date: Date) => date.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' }).replaceAll('/', '.');
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} showSiteChrome={false}>
	<div class="landing-page">
		<header class="masthead" id="top">
			<a class="wordmark" href="#top" aria-label="Lun-hackin 首頁">@Lun-hackin</a>
			<nav class="social-links" aria-label="社群連結">
				<a href="https://github.com/" aria-label="GitHub" title="GitHub"><span aria-hidden="true">GH</span></a>
				<a href="https://x.com/" aria-label="X" title="X"><span aria-hidden="true">𝕏</span></a>
				<a href="mailto:hello@lun-hackin.dev" aria-label="Email" title="Email"><span aria-hidden="true">✉</span></a>
				<a href="/rss.xml" aria-label="RSS" title="RSS"><span aria-hidden="true">◔</span></a>
			</nav>
		</header>

		<main>
			<section class="overview" aria-label="近期內容">
				<div class="overview-column featured-projects">
					<div class="section-label"><h2>作品</h2><a href="#work">查看作品 <span aria-hidden="true">↗</span></a></div>
					<ul class="project-list">
						{projects.map((project) => (
							<li>
								<a href="#work">
									<span class="list-arrow" aria-hidden="true">⟶</span>
									<span><strong>{project.title}</strong><small>{project.description}</small></span>
								</a>
							</li>
						))}
					</ul>
					<a class="text-link" href="#work">所有作品 <span aria-hidden="true">↗</span></a>
				</div>

				<div class="overview-column recent-writing">
					<div class="section-label"><h2>文章</h2><a href="/blog">全部文章 <span aria-hidden="true">↗</span></a></div>
					<div class="article-list">
						{posts.length ? posts.slice(0, 4).map((post) => (
							<a class="article-row" href={`/blog/${post.id}/`}>
								<div class="article-copy">
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									{post.data.tags.length > 0 && <div class="tag-list">{post.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}</div>}
								</div>
								<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
							</a>
						)) : <p class="empty-note">新文章正在整理中。</p>}
					</div>
					<p class="scroll-note"><span class="wave-mark" aria-hidden="true">∿∿∿∿</span> 往下捲動，繼續看看</p>
				</div>
			</section>

			<section class="journey-section work-section" id="work" aria-labelledby="work-title">
				<div class="journey-sticky">
					<div class="journey-heading"><p class="eyebrow">SELECTED PROJECTS</p><h2 id="work-title">作品</h2></div>
					<div class="project-rail" aria-label="作品列表">
						{projects.map((project, index) => (
							<article class:list={['showcase-card', project.tone]}>
								<div class="card-meta"><span>{project.year}</span><span>0{index + 1} / 03</span></div>
								<div class="card-main"><h3>{project.title}</h3><p>{project.description}</p></div>
								<div class="card-footer"><span>{project.stack.join(' · ')}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="journey-section interests-section" id="interests" aria-labelledby="interests-title">
				<div class="journey-sticky interest-sticky">
					<div class="journey-heading"><p class="eyebrow">THINGS I LIKE</p><h2 id="interests-title">興趣</h2></div>
					<div class="interest-rail">
						{interests.map((interest, index) => (
							<article class:list={['interest-card', index % 2 ? 'interest-alt' : '']}>
								<div class="interest-top"><span>{interest.tag}</span><span>{interest.number}</span></div>
								<div class="interest-copy"><h3>{interest.title}</h3><p>{interest.description}</p></div>
								<span class="interest-index" aria-hidden="true">0{index + 1}</span>
							</article>
						))}
					</div>
				</div>
			</section>
		</main>

		<footer class="landing-footer"><a href="#top">回到頂端 ↑</a><span>© {new Date().getFullYear()} Lun-hackin</span><span>用好奇心持續製作。</span></footer>
	</div>
</BaseLayout>
