---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout title="Projects" description="Things I have built: smart contracts, front-end interactions and websites.">
	<section class="listing-page" aria-labelledby="projects-title">
		<header class="listing-head">
			<p class="eyebrow">SELECTED PROJECTS</p>
			<h1 id="projects-title">Projects</h1>
			<span class="journey-count">{pad(projects.length)} projects</span>
		</header>
		<ul class="project-grid">
			{projects.map((project, index) => (
				<li>
					<a class:list={['project-tile', 'tone-panel', project.data.tone]} href={`/projects/${project.id}/`}>
						<div class="card-meta"><span>{project.data.year}</span><span>{pad(index + 1)} / {pad(projects.length)}</span></div>
						<div class="card-main"><h2>{project.data.title}</h2><p>{project.data.description}</p></div>
						<div class="card-footer"><span>{project.data.stack.join(' · ')}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
					</a>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>
